generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AGENT
  TEAM_LEADER
  MANAGER
  ADMIN
}

enum CallType {
  FIRST_CALL
  SECOND_CALL
  FOLLOW_UP
  GENERAL
}

model Team {
  id       String  @id @default(cuid())
  name     String
  leaderId String? @unique
  leader   User?   @relation("TeamLeader", fields: [leaderId], references: [id])
  members  User[]  @relation("TeamMembers")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(AGENT)
  teamId        String?
  team          Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  leadingTeam   Team?          @relation("TeamLeader")
  evaluations   Evaluation[]   @relation("EvaluatedAgent")
  activityLogs  ActivityLog[]
  feedbacks     Feedback[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  lastLoginAt   DateTime?
  mustChangePassword Boolean  @default(false)
  managerId     String?
  manager       User?          @relation("ManagerTL", fields: [managerId], references: [id], onDelete: SetNull)
  teamLeaders   User[]         @relation("ManagerTL")
  isActive      Boolean        @default(true)

  @@index([managerId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  section   String?
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String
  comment   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  message     String
  isRead      Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now())
}

model Prompt {
  id            String   @id @default(cuid())
  name          String
  callType      CallType
  content       String
  version       String
  isActive      Boolean  @default(true)
  contentEn     String?  // cached AI translation of `content` (display-only)
  contentEnHash String?  // sha256 of the `content` that produced contentEn
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Report {
  id        String   @id @default(cuid())
  title     String
  type      String
  startDate DateTime
  endDate   DateTime
  data      String
  createdAt DateTime @default(now())
}

model Evaluation {
  id              String    @id @default(cuid())
  agentId         String
  agent           User      @relation("EvaluatedAgent", fields: [agentId], references: [id])
  customerName    String
  callDuration    String
  transcript      String
  report          String
  score           Int
  callType        CallType  @default(SECOND_CALL)
  promptId        String?
  classificationVerified Boolean @default(false) // admin confirmed the call type is correct → hidden from the suspicious-classifications scan
  sectionScores   Json?
  weakCriteria    Json?
  callDate        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  // Kriko entegrasyonu
  externalCallId  String?   @unique          // kriko id, mükerrer import koruması
  externalAgentName String?                   // kriko'dan gelen ham agent adı (eşleşmeyenler için)
  recordingUrl    String?                     // audio URL (Kriko ekleyince doldurulacak)
  unassigned      Boolean   @default(false)   // agent eşleşmedi → admin atayacak
  source          String    @default("MANUAL") // MANUAL | KRIKO | FIREFLIES

  // Takip alanları
  agentRead       Boolean   @default(false)
  agentReadAt     DateTime?
  coachingDone    Boolean   @default(false)
  coachingDoneAt  DateTime?
  coachingNotes   String?
  coachingById    String?
  coachingByName  String?
}

model SyncLog {
  id           String   @id @default(cuid())
  source       String                          // KRIKO | FIREFLIES
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  date         String                          // hangi tarih senkronize edildi (YYYY-MM-DD)
  totalFetched Int      @default(0)
  imported     Int      @default(0)
  skipped      Int      @default(0)
  unassigned   Int      @default(0)
  failed       Int      @default(0)
  error        String?
  trigger      String   @default("MANUAL")     // MANUAL | CRON
}

model NegativeKeyword {
  id          String   @id @default(cuid())
  word        String   @unique
  createdById String                    // audit only — no FK, user deletion does not cascade
  createdAt   DateTime @default(now())
}

model CoachingSummary {
  id          String    @id @default(cuid())
  agentId     String    @unique
  summary     String?
  actionItems Json?
  generatedAt DateTime?
  evalCount   Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model QaReport {
  id             String        @id @default(cuid())
  reportDate     DateTime
  uploadedById   String
  uploadedByName String
  createdAt      DateTime      @default(now())
  rows           QaReportRow[]

  @@index([reportDate])
}

model QaReportRow {
  id                  String   @id @default(cuid())
  qaReportId          String
  report              QaReport @relation(fields: [qaReportId], references: [id], onDelete: Cascade)
  salesOwner          String?
  status              String?
  bookingDate         String?
  crmId               String?
  customerName        String?
  dealStage           String?
  contactType         String?
  contactMethod       String?
  recentNote          String?
  country             String?
  timeFrame           String?
  callRecord          Boolean  @default(false)
  matchedEvaluationId String?
  manualOverride      Boolean  @default(false)
  qaNotes             String?

  @@index([qaReportId])
}
